<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="12dp">
  <LinearLayout android:id="@+id/w_text" android:layout_width="0dp" android:layout_height="wrap_content"
      android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="DriveMate" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
    <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="No trip running" android:textColor="#B4BCC8" android:textSize="13sp"/>
  </LinearLayout>
  <TextView android:id="@+id/w_btn" android:layout_width="wrap_content" android:layout_height="44dp"
      android:gravity="center" android:paddingLeft="18dp" android:paddingRight="18dp"
      android:background="@drawable/widget_btn" android:text="Start trip"
      android:textColor="#0B0E16" android:textSize="15sp" android:textStyle="bold"/>
</LinearLayout>
